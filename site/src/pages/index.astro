---
const downloadURL = 'https://download.hostblock.app';
const gumroadURL = 'https://smithlabs.gumroad.com/l/host-block';
const githubURL = 'https://github.com/dotspencer/host-block';

// const features = [
//   'Source available on GitHub',
//   'Default blocklists for ads, trackers, and adult content',
//   'Add your own from any URL or GitHub Gist',
//   'Toggle off in one click from the menu bar',
// ];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/appicon.png" type="image/png" />
    <title>HostBlock — system-wide ad &amp; tracker blocking for Mac</title>
    <meta
      name="description"
      content="Block ads, trackers, and unwanted domains across every browser and app on your Mac. No extensions, no proxy, no VPN."
    />
    <meta property="og:title" content="HostBlock" />
    <meta
      property="og:description"
      content="System-wide ad & tracker blocking from your menu bar."
    />
    <meta property="og:image" content="https://hostblock.app/appicon.png" />
    <meta property="og:url" content="https://hostblock.app" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <main>
      <section class="hero">
        <img
          class="icon"
          src="/appicon.png"
          alt="HostBlock icon"
          width="112"
          height="112"
        />
        <h1>HostBlock</h1>
        <div class="tagline">
          A lightweight menu bar app that updates your hosts file to block ads,
          trackers, and malware across your entire Mac.
        </div>
        <!-- <p class="tagline">
          A lightweight menu bar app that updates your hosts file to block ads,
          trackers, and other malicious domains.
        </p> -->
        <!-- <div class="tagline">
          A lightweight macOS menu bar app that blocks ads, trackers, and
          malware.
        </div> -->
        <!-- <p class="tagline">
          Block ads, trackers, and unwanted domains across every browser and app
          on your Mac.
        </p> -->
        <div class="cta-wrap">
          <a class="cta primary" href={downloadURL}>Download for Mac</a>
          <a class="cta" href={gumroadURL}>Get a License</a>
        </div>
        <!-- <p class="sub">No extensions, no proxy, no VPN.</p> -->
      </section>

      <!-- <img
        class="screenshot"
        src="/screenshot.png"
        alt="The HostBlock menu bar app showing its default blocklists"
        width="792"
        height="1258"
      /> -->

      <!-- <p>
        HostBlock edits your hosts file directly, so blocking is instant,
        system-wide, and fully local. Your traffic never leaves your machine.
      </p> -->

      <!-- <ul class="features">
        {features.map((f) => <li>{f}</li>)}
      </ul> -->

      <footer>
        <a
          class="github"
          href={githubURL}
          aria-label="HostBlock on GitHub"
          title="View the source on GitHub"
        >
          <svg
            viewBox="0 0 16 16"
            width="28"
            height="28"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
        </a>
      </footer>
    </main>

    <style is:global>
      :root {
        --bg: #1e1e21;
        --surface: #27272a;
        --stroke: rgba(255, 255, 255, 0.09);
        --accent: #4ad480;
        --text: #f5f5f7;
        --text-2: rgba(255, 255, 255, 0.6);
        --text-3: rgba(255, 255, 255, 0.4);
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html {
        color-scheme: dark;
      }
      body {
        background: var(--bg);
        color: var(--text);
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      main {
        max-width: 640px;
        margin: 0 auto;
        padding: 72px 24px 56px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      p {
        color: var(--text);
      }
      .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .icon {
        width: 112px;
        height: 112px;
      }
      h1 {
        font-size: 2.6rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-top: 20px;
      }
      .tagline {
        margin-top: 12px;
        font-size: 1.2rem;
        color: var(--text-2);
        max-width: 32ch;
      }
      .cta-wrap {
        display: flex;
        gap: 12px;
        margin-top: 28px;
        flex-wrap: wrap;
        justify-content: center;
      }
      .cta {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        font-size: 1rem;
        font-weight: 600;
        padding: 11px 20px;
        border-radius: 8px;
        color: var(--text);
        background: var(--surface);
        border: 1px solid var(--stroke);
        transition:
          transform 0.1s ease,
          filter 0.1s ease;
      }
      .cta.primary {
        background: var(--accent);
        color: #06110a;
        border-color: transparent;
      }
      .cta:hover {
        transform: translateY(-1px);
        filter: brightness(1.05);
      }
      .sub {
        margin-top: 18px;
        font-size: 0.9rem;
        color: var(--text-3);
      }
      .features {
        list-style: none;
        margin-top: 48px;
        display: grid;
        gap: 10px;
        text-align: left;
        width: 100%;
        max-width: 420px;
      }
      .features li {
        position: relative;
        padding-left: 26px;
        color: var(--text-2);
      }
      .features li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.55em;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background: var(--accent);
      }
      .screenshot {
        margin-top: 44px;
        width: 100%;
        max-width: 340px;
        height: auto;
      }
      footer {
        margin-top: 56px;
      }
      .github {
        display: inline-flex;
        color: var(--text-2);
        transition:
          color 0.15s ease,
          transform 0.1s ease;
      }
      .github:hover {
        color: var(--text);
        transform: translateY(-1px);
      }
      @media (max-width: 480px) {
        h1 {
          font-size: 2.1rem;
        }
        main {
          padding-top: 48px;
        }
      }
    </style>
  </body>
</html>
